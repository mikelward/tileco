{
  "manifest_version": 3,
  "name": "tileco",
  "version": "0",
  "description": "dwm-style tiling and workspaces for Chrome and web app windows on chromeOS.",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "system.display",
    "scripting",
    "power"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "focus-next": {
      "description": "Focus the next window in the stack (Search+J)",
      "suggested_key": {
        "chromeos": "Search+J",
        "default": "Alt+Shift+J"
      }
    },
    "focus-prev": {
      "description": "Focus the previous window in the stack (Search+K)",
      "suggested_key": {
        "chromeos": "Search+K",
        "default": "Alt+Shift+K"
      }
    },
    "popup": {
      "description": "Open the dashboard: workspaces, clocks and the launcher (Search+Space)",
      "suggested_key": {
        "chromeos": "Search+Space",
        "default": "Alt+Shift+Space"
      }
    },
    "swap-master": {
      "description": "Swap the window with the master (Search+Shift+M)"
    },
    "attention": {
      "description": "Go to the window wanting attention, else the last window (Search+Tab)",
      "suggested_key": {
        "chromeos": "Search+Tab",
        "default": "Alt+Shift+U"
      }
    },
    "layout-next": {
      "description": "Next layout (Search+.)"
    },
    "move-next": {
      "description": "Move the window down the stack (Search+Shift+J)"
    },
    "move-prev": {
      "description": "Move the window up the stack (Search+Shift+K)"
    },
    "grow": {
      "description": "Grow the master (Search+N)"
    },
    "shrink": {
      "description": "Shrink the master (Search+H)"
    },
    "master-add": {
      "description": "Add a master (Search+I)"
    },
    "master-remove": {
      "description": "Remove a master (Search+D)"
    },
    "layout-prev": {
      "description": "Previous layout (Search+,)"
    },
    "monocle": {
      "description": "Toggle monocle (Search+O)"
    },
    "float": {
      "description": "Toggle floating (Search+Shift+F)"
    },
    "workspace-next": {
      "description": "Next workspace (Search+PageDown)"
    },
    "workspace-prev": {
      "description": "Previous workspace (Search+PageUp)"
    },
    "send-next": {
      "description": "Send the window to the next workspace (Search+Shift+PageDown)"
    },
    "send-prev": {
      "description": "Send the window to the previous workspace (Search+Shift+PageUp)"
    },
    "workspace-1": {
      "description": "Go to workspace 1 (Search+1)"
    },
    "workspace-2": {
      "description": "Go to workspace 2 (Search+2)"
    },
    "workspace-3": {
      "description": "Go to workspace 3 (Search+3)"
    },
    "workspace-4": {
      "description": "Go to workspace 4 (Search+4)"
    },
    "workspace-5": {
      "description": "Go to workspace 5 (Search+5)"
    },
    "workspace-6": {
      "description": "Go to workspace 6 (Search+6)"
    },
    "workspace-7": {
      "description": "Go to workspace 7 (Search+7)"
    },
    "workspace-8": {
      "description": "Go to workspace 8 (Search+8)"
    },
    "workspace-9": {
      "description": "Go to workspace 9 (Search+9)"
    },
    "send-1": {
      "description": "Send the window to workspace 1 (Search+Shift+1)"
    },
    "send-2": {
      "description": "Send the window to workspace 2 (Search+Shift+2)"
    },
    "send-3": {
      "description": "Send the window to workspace 3 (Search+Shift+3)"
    },
    "send-4": {
      "description": "Send the window to workspace 4 (Search+Shift+4)"
    },
    "send-5": {
      "description": "Send the window to workspace 5 (Search+Shift+5)"
    },
    "send-6": {
      "description": "Send the window to workspace 6 (Search+Shift+6)"
    },
    "send-7": {
      "description": "Send the window to workspace 7 (Search+Shift+7)"
    },
    "send-8": {
      "description": "Send the window to workspace 8 (Search+Shift+8)"
    },
    "send-9": {
      "description": "Send the window to workspace 9 (Search+Shift+9)"
    },
    "keep-awake": {
      "description": "Toggle keep awake (Search+S)"
    },
    "app-browser": {
      "description": "Open a new browser window (Search+G)"
    },
    "app-calendar": {
      "description": "Open app 1, Google Calendar unless changed in tileco's options (Search+C)"
    },
    "app-chat": {
      "description": "Open app 2, Google Chat unless changed in tileco's options (Search+Shift+C)"
    },
    "app-meet": {
      "description": "Open app 3, Google Meet unless changed in tileco's options (Search+M)"
    },
    "app-music": {
      "description": "Open app 4, YouTube Music unless changed in tileco's options (Search+Y)"
    }
  },
  "icons": {
    "16": "icons/tileco-16.png",
    "32": "icons/tileco-32.png",
    "48": "icons/tileco-48.png",
    "128": "icons/tileco-128.png"
  },
  "action": {
    "default_title": "tileco",
    "default_icon": {
      "16": "icons/tileco-16.png",
      "32": "icons/tileco-32.png"
    }
  }
}
